# ============================================================
#  TLL TimeSlayer — Environment Variables
#  Copy this file to .env and fill in your actual values.
#  NEVER commit the real .env file to version control.
# ============================================================

# ── Supabase (Required — both server & client) ────────────────
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# ── Supabase Service Role (Required for server WRITES only) ───
# This key bypasses RLS. NEVER expose it to the browser/client.
SUPABASE_SERVICE_KEY=your_service_role_key_here

# ── CORS & Networking ────────────────────────────────────────
# Production: set to your Vercel/CDN domain (comma-separated for multiple).
# Development: defaults to http://localhost:5299 (no change needed).
CLIENT_ORIGIN=http://localhost:5299

# In production, set this to your Railway backend URL:
# VITE_SERVER_URL=https://your-app.railway.app

# ── Admin Security ────────────────────────────────────────────
# A strong random token required on all /api/admin/* requests.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Development: leave blank to allow open admin access with a warning.
ADMIN_SECRET=

# ── Server Port ───────────────────────────────────────────────
PORT=3001
