{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "rootDir": ".",
    "outDir": "./dist-client",
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "paths": {
      "@engine/*": ["./src/*"]
    }
  },
  "include": ["client/**/*", "src/**/*"]
}

